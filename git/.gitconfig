[alias]
	hist = log --graph --abbrev-commit --decorate --date=short \
		--format=format:'%C(bold cyan)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)%an%C(reset) %C(bold yellow)%d%C(reset)' \
		--branches --remotes --tags
	st = status
	ls = status
[user]
	email = haimovyoav.work@gmail.com
	name = Yoav Haimov
  signingkey = ~/.ssh/id_ed25519.pub
[gpg]
  format = ssh
[commit]
  gpgsign = true
  verbose = true
[credential]
	helper = store
[core]
	editor = nvim
  pager = delta
[push]
	autoSetupRemote = true
[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
