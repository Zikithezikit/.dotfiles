[alias]
	hist = log --graph --abbrev-commit --decorate --date=short \
		--format=format:'%C(bold cyan)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)%an%C(reset) %C(bold yellow)%d%C(reset)' \
		--branches --remotes --tags
	st = status
	ls = status
[user]
	email = haimovyoav.work@gmail.com
	name = Yoav Haimov
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
	verbose = true
# gh keeps the token in the keyring; `store` wrote it to ~/.git-credentials in plaintext.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
