#!/usr/bin/env bash

#
# i3-wsl-up -- one command to get an i3 session running on WSL.
#
# Checks every dependency, installs whatever is missing, starts the session,
# and tells you what to do on the Windows side. Safe to run as often as you
# like: once everything is in place it does no work and just (re)starts the
# session.
#
#   i3-wsl-up            check, install if needed, start
#   i3-wsl-up --check    only report what is missing, install nothing
#   i3-wsl-up --no-start set everything up but leave the session stopped
#   i3-wsl-up --help
#
# Needs sudo only when something is actually missing, and only for that.

set -uo pipefail

# Resolve through the stow symlink to find the package this script lives in,
# so the installer next to it can be run.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PKG_DIR="$(dirname "$(dirname "$(dirname "$SELF")")")"
INSTALLER="$PKG_DIR/install-wsl.sh"
I3WSL="$(dirname "$SELF")/i3-wsl"

c_r=$'\033[0m'; c_dim=$'\033[2m'; c_red=$'\033[1;31m'
c_grn=$'\033[1;32m'; c_ylw=$'\033[1;33m'; c_cy=$'\033[1;36m'

CHECK_ONLY=0
DO_START=1
for arg in "$@"; do
  case "$arg" in
    --check)    CHECK_ONLY=1 ;;
    --no-start) DO_START=0 ;;
    -h|--help)  sed -n '4,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf "%sx%s unknown option: %s\n\n" "$c_red" "$c_r" "$arg" >&2
       sed -n '4,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
  esac
done

MISSING_PKGS=()
NEED_INSTALLER=0

note_missing() { MISSING_PKGS+=("$1"); NEED_INSTALLER=1; }

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------
printf "\n%s%si3 on WSL -- getting ready%s\n\n" "$c_cy" "$(printf '─%.0s' {1..30})" "$c_r"

# TurboVNC. The X server itself; without it there is no session to start.
if [ -x /opt/TurboVNC/bin/vncserver ]; then
  printf "  %sok%s   TurboVNC\n" "$c_grn" "$c_r"
else
  printf "  %s--   TurboVNC (installing)\n" "$c_ylw" "$c_r"
  NEED_INSTALLER=1
fi

# Commands the i3 and polybar configs actually exec. Each maps to one package.
while read -r cmd pkg; do
  [ -n "$cmd" ] || continue
  if command -v "$cmd" >/dev/null 2>&1; then
    printf "  %sok%s   %s\n" "$c_grn" "$c_r" "$cmd"
  else
    printf "  %s--   %-16s %s(missing %s)%s\n" "$c_ylw" "$c_r" "$c_dim" "$pkg" "$c_r"
    note_missing "$pkg"
  fi
done <<'EOF'
i3 i3-wm
polybar polybar
rofi rofi
picom picom
feh feh
pavucontrol pavucontrol
pactl pulseaudio-utils
i3lock-fancy i3lock-fancy
xbacklight xbacklight
xclip xclip
dbus-launch dbus-x11
setxkbmap x11-xkb-utils
xmodmap x11-xkb-utils
EOF

# Ghostty is the terminal $mod+Return opens. Not fatal if absent -- xterm is a
# usable fallback -- so only a warning.
if command -v ghostty >/dev/null 2>&1; then
  printf "  %sok%s   ghostty\n" "$c_grn" "$c_r"
else
  printf "  %s!!%s   ghostty missing -- \$mod+Return will fail (no xterm fallback in the i3 config)\n" \
    "$c_ylw" "$c_r"
fi

# Fonts. Polybar draws every icon through these; without them the bar is a row
# of tofu boxes, and the i3 workspace names lose their FontAwesome glyphs.
font_ok=1
for f in "Iosevka Nerd Font" "Symbols Nerd Font" "Symbols Nerd Font Mono" "FontAwesome"; do
  fc-match "$f" 2>/dev/null | grep -q "$f" || { font_ok=0; printf "  %s--%s   %s font missing\n" "$c_ylw" "$c_r" "$f"; }
done
if [ "$font_ok" -eq 1 ]; then
  printf "  %sok%s   fonts (Nerd + FontAwesome)\n" "$c_grn" "$c_r"
else
  NEED_INSTALLER=1
fi

# The session script itself: this script and i3-wsl are useless without it.
if [ -x "$HOME/.config/i3-wsl/xsession" ]; then
  printf "  %sok%s   session script stowed\n" "$c_grn" "$c_r"
else
  printf "  %s--%s   'wsl' package is not stowed (running: stow -d ~/.dotfiles -t ~ wsl)\n" "$c_ylw" "$c_r"
  NEED_INSTALLER=1
fi

printf '\n'

# ---------------------------------------------------------------------------
# Install whatever is missing
# ---------------------------------------------------------------------------
if [ "$NEED_INSTALLER" -eq 0 ]; then
  printf "%sEverything is already installed.%s\n" "$c_grn" "$c_r"
elif [ "$CHECK_ONLY" -eq 1 ]; then
  printf "%sWould install:%s %s\n" "$c_cy" "$c_r" "${MISSING_PKGS[*]:-TurboVNC and/or fonts}"
elif [ ! -r "$INSTALLER" ]; then
  printf "%sx%s Cannot find the installer at %s\n" "$c_red" "$c_r" "$INSTALLER" >&2
  exit 1
elif [ ! -t 0 ] && [ -t 1 ]; then
  # Output goes to a terminal but there is no stdin to type a sudo password
  # into -- a .bat launcher or a pipe, for instance.
  printf "%sx%s Installing needs a sudo password, and there is no terminal to type it into.\n" "$c_red" "$c_r" >&2
  printf "  Run %si3-wsl-up%s from an interactive WSL shell instead.\n" "$c_dim" "$c_r" >&2
  exit 1
else
  printf "%sInstalling what is missing (the only step that needs sudo)...%s\n\n" "$c_dim" "$c_r"
  bash "$INSTALLER"
  status=$?
  # The installer exits non-zero on partial failure, but may still have fixed
  # enough for the session to run -- so let the start step be the real arbiter
  # rather than trusting its exit code here.
  if [ $status -ne 0 ]; then
    printf "\n%sThe installer reported failures -- carrying on to see whether the session still starts.%s\n" "$c_ylw" "$c_r"
  fi
fi
printf '\n'

# --check and --no-start are honoured whether or not anything was installed.
if [ "$CHECK_ONLY" -eq 1 ]; then
  if [ "$NEED_INSTALLER" -eq 0 ]; then
    printf "%sNothing to do.%s\n" "$c_grn" "$c_r"
    exit 0
  fi
  printf "%sRun %si3-wsl-up%s to install and start.\n" "$c_dim" "$c_r" "$c_dim"
  exit 1
fi

[ "$DO_START" -eq 1 ] || exit 0

# ---------------------------------------------------------------------------
# Start (or report an already-running session)
# ---------------------------------------------------------------------------
# Already running? Reuse it rather than trying to start a second X server on
# the same display.
#
# Deliberately not `i3-wsl status | grep -q ...`: grep -q exits at the first
# match, which SIGPIPEs i3-wsl, and under `set -o pipefail` that turns a
# successful match into a non-zero pipeline -- so this test reported "not
# running" for a running session, and then tried to start a second one.
status_out="$("$I3WSL" status 2>/dev/null)"
case "$status_out" in
    *"Xvnc is up"*)
        printf '%sThe session is already running.%s\n\n' "$c_grn" "$c_r"
        printf '  %sReconnect the viewer, or start over with: i3-wsl restart%s\n\n' "$c_dim" "$c_r"
        # This is the moment a stale session is most likely to bite -- you are
        # about to reconnect and look at it -- so re-check the screen here too
        # rather than only on a fresh start.
        "$I3WSL" doctor 2>/dev/null | grep -A12 'X screen is' || true
        exit 0
        ;;
esac

"$I3WSL" start || exit 1

# ---------------------------------------------------------------------------
# Windows side
# ---------------------------------------------------------------------------
cat <<EOF
${c_cy}Next, on Windows${c_r}

  ${c_dim}1.${c_r}  Open the TurboVNC Viewer
      ${c_dim}(it is in your Downloads folder if install-wsl.sh staged it)${c_r}
  ${c_dim}2.${c_r}  Connect to  ${c_grn}localhost:5912${c_r}
  ${c_dim}3.${c_r}  Press  ${c_grn}F11${c_r}  for fullscreen

${c_dim}Fullscreen is not optional: in a windowed viewer Windows keeps the Super
key, so \$mod+Return, \$mod+d and every other i3 binding do nothing.${c_r}
EOF

# WSLg advice, only when it is actually costing us something.
if [ ! -w /tmp/.X11-unix ]; then
  cat <<EOF

${c_cy}One suggestion${c_r}

  WSLg is holding /tmp/.X11-unix read-only, so this session has to reach its
  X server over TCP, and that leaves an X11 port (6012) listening on all
  interfaces. Harmless in practice -- the X cookie is required and WSL2's NAT
  hides the address -- but you can close it by turning WSLg off:

    ${c_dim}in %%USERPROFILE%%\\.wslconfig:${c_r}
      ${c_dim}[wsl2]${c_r}
      ${c_dim}guiApplications=false${c_r}

    ${c_dim}then, in PowerShell:${c_r}
      ${c_dim}wsl --shutdown${c_r}

  ...then run ${c_dim}i3-wsl-up${c_r} again. It will switch to the Unix socket by
  itself, and there will be no X11 TCP port at all.
EOF
fi
