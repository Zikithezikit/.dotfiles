# Gaps
gaps inner 10
gaps outer 0

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
font pango:DejaVu Sans Mono, FontAwesome 16

# Before i3 v4.8, we used to recommend this one as the default:
# font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
# The font above is very space-efficient, that is, it looks good, sharp and
# clear in small sizes. However, its unicode glyph coverage is limited, the old
# X core fonts rendering does not support right-to-left and this being a bitmap
# font, it doesn’t scale on retina/hidpi displays.

# ---------------------------------------------------------------------------
# Machine-specific settings
# ---------------------------------------------------------------------------
# Everything that depends on *this* machine's outputs, panels and helper
# scripts lives in ~/.config/i3.local.conf, which is pulled in only if it
# exists. That indirection is what lets one config serve both a two-monitor
# desktop and the WSL/VNC session, whose single virtual screen has no DP-1 or
# DVI-D-0 for a `workspace ... output` or `xrandr --output` line to act on --
# those would otherwise be logged as errors on every start.
#
# i3.local.conf.example in this directory is a filled-in version; copy it to
# ~/.config/i3.local.conf and edit to taste. It is deliberately NOT part of
# the repo, because its contents differ per machine.
include_if_exists ~/.config/i3.local.conf

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
# ghostty is GTK4, and on a software-rendered X server it only produces a
# window the window manager can actually manage when the session exports
# GDK_BACKEND=x11 and GSK_RENDERER=cairo. The WSL session does exactly that;
# on an ordinary desktop neither is needed.
bindsym $mod+Return exec ghostty

# kill focused window
# bindsym $mod+space exec "/home/theprimeagen/dotfiles/awesome-streamerrc/ThePrimeagen/tmux2"

bindsym $mod+Shift+q kill

# start rofi (a program launcher)
# Theme lives in ~/.config/rofi/config.rasi (stowed from this repo) and already
# carries the Archcraft Theme 4 palette, so rofi needs no color flags here.
# --release matters: on a keypress i3 still holds the keyboard grab, so rofi
# cannot take it. See the i3 section of rofi(1).
# drun reads the same .desktop files the old i3-dmenu-desktop wrapper did.
bindsym --release $mod+d exec --no-startup-id rofi -show drun

# Window switcher. Same list, but running windows are reachable first and
# typing a name switches to a running window instead of launching a new one.
bindsym --release $mod+space exec --no-startup-id rofi -show window

# Everything in one list: windows, then apps, then $PATH binaries.
bindsym --release $mod+Shift+d exec --no-startup-id rofi -show combi

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+z split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child


