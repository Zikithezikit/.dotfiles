# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

# The i3bar was replaced by polybar (Archcraft theme 4 look).
# launch.sh starts one bar per monitor: "main" (tray) on the primary
# output, "aux" (no tray) on the others. i3blocks config is kept as a
# fallback in case the bar is ever switched back.
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ------------------------------------------
# CUSTOM KEYS START
# ------------------------------------------
# NetworkManager's tray applet. WSL has no NetworkManager, so the binary is
# simply absent there; the check keeps i3 from logging a failure every start.
exec --no-startup-id sh -c 'command -v nm-applet >/dev/null && exec nm-applet'

# Mode switches and resolution changes. xrandr against named outputs, so they
# only mean anything on a real multi-monitor X session -- they are in
# ~/.config/i3.local.conf rather than here.

# FKeys
# Pulse Audio controls (polybar pulseaudio module picks changes up on its own)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume 0 +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume 0 -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute 0 toggle

# Media control keys (music.sh picks the same player the bar shows: first
# Playing, else first Paused; bar music module refreshes every second)
bindsym XF86AudioPlay exec --no-startup-id ~/.config/polybar/scripts/music.sh play-pause
bindsym XF86AudioPause exec --no-startup-id ~/.config/polybar/scripts/music.sh pause
bindsym XF86AudioNext exec --no-startup-id ~/.config/polybar/scripts/music.sh next
bindsym XF86AudioPrev exec --no-startup-id ~/.config/polybar/scripts/music.sh previous
#
# # Sreen brightness controls
bindsym XF86MonBrightnessUp exec xbacklight -inc 20 # increase screen brightness
bindsym XF86MonBrightnessDown exec xbacklight -dec 20 # decrease screen brightness

# Alsa audio controls. These switch between sound cards using
# ~/.config/i3/scripts/alsa, which is not in this repo -- it is a per-machine
# helper. Uncomment once you have written it, otherwise the keys are dead.
# bindsym $mod+Shift+comma exec --no-startup-id ~/.config/i3/scripts/alsa restore
# bindsym $mod+semicolon    exec --no-startup-id ~/.config/i3/scripts/alsa down Headphone
# bindsym $mod+comma        exec --no-startup-id ~/.config/i3/scripts/alsa up Headphone
bindsym $mod+m move workspace to output left

# Suspend
bindsym $mod+Shift+period exec systemctl suspend



# Change language
## Set layouts on startup

exec --no-startup-id setxkbmap -layout us,il -option grp:alt_space_toggle
# grp:win_space_toggle (the old value here) can never fire: $mod+space is
# bound above to the rofi window switcher, and i3 grabs the key before X ever
# sees it. Alt+Space leaves Win+Space free for rofi and still toggles the
# layout -- bound to $mod in i3, so it needs no modifier of its own.

# lock screen
bindsym $mod+Ctrl+l exec --no-startup-id i3lock-fancy

# Window transparency needs a compositor, and this config does not use one by
# default: it sets no client opacity, no fade and no rounded corners, so picom
# has nothing to composite. On a normal X session picom is still the only way
# to get any of that, so enable it here -- or, better, in
# ~/.config/i3.local.conf so it can be per-machine.
#
# It is deliberately NOT started unconditionally. On a software-rasterised
# X server (the WSL/VNC session) it composites every frame on the CPU for no
# visible gain, and a compositor that redraws in step with the input is a
# classic source of the whole desktop appearing to freeze mid-keypress.
# exec --no-startup-id picom --backend xrender

## Wallpaper
# Re-randomised every 2 minutes. Guarded on the glob actually matching: when
# the directory is empty or absent the glob stays literal, feh errors, and the
# loop spins forever filling the log.
exec --no-startup-id sh -c 'ls ~/Pictures/Wallpapers/* >/dev/null 2>&1 || exit 0; while true; do feh --bg-fill --randomize ~/Pictures/Wallpapers/*; sleep 2m; done'
# exec --no-startup-id feh --bg-scale ~/Pictures/Wallpapers/wallpaper-1.jpg
#

# Night light. Warms the screens from dusk (16:00) to dawn (05:00); the schedule
# lives in ~/.config/gammastep/config.ini, which is stowed from this repo.
#
# `i3-msg reload` re-runs this line, so kill any running instance first:
# two daemons writing the same gamma ramps would otherwise fight, and the one
# that exits last restores neutral, wiping the other's effect.
#
# Skipped when gammastep is not installed -- it cannot work under WSL anyway,
# where there is no gamma-ramp interface, and the bare exec would otherwise
# put "gammastep: not found" in the log on every reload.
exec_always --no-startup-id sh -c 'command -v gammastep >/dev/null || exit 0; pkill -x gammastep; sleep 1; gammastep'
bindsym $mod+Shift+g exec --no-startup-id pkill -USR1 -x gammastep

# ---------------------------------------------------------------------------
# Optional desktop integrations
# ---------------------------------------------------------------------------
# kdeconnectd (phone notifications, clipboard sharing) and its tray indicator.
# Neither exists on WSL, and neither is installed on a minimal desktop either,
# so both are optional: exec'ing a missing binary only ever produces a line in
# the log, but doing it on every reload adds up to noise.
exec --no-startup-id sh -c '[ -x /usr/lib/kdeconnectd ] && exec /usr/lib/kdeconnectd'
exec --no-startup-id sh -c 'command -v kdeconnect-indicator >/dev/null && exec kdeconnect-indicator'
