/* Archcraft i3wm Premium - Theme 4 (rofi)
 *
 * Palette mirrors polybar/colors.ini and the i3 color scheme block:
 *   background #191d27   surface #232836   foreground #c6cbd6
 *   primary    #ffcc66   muted     #767d8a   dot/sep #26384d
 *   urgent     #f07178   unfocused  #42a5f5
 * The selected row is primary-on-background, which is what the old
 * `dmenu -sb "#ffcc66" -sf "#191d27"` binding looked like.
 *
 * i3 bindings (see ../i3/.config/i3/config):
 *   $mod+d        -> rofi -show drun
 *   $mod+space    -> rofi -show window
 *   $mod+Shift+d  -> rofi -show combi
 * All three use `bindsym --release` so rofi can grab the keyboard from i3.
 */

/* ---- Palette + fonts (referenced as @name below) ---- */

* {
    background: #191d27;
    surface:    #232836;
    foreground: #c6cbd6;
    primary:    #ffcc66;
    muted:      #767d8a;
    dot:        #26384d;
    urgent:     #f07178;
    unfocused:  #42a5f5;

    /* Whole text-style values are spelled out as separate globals rather
     * than composed inline below: rofi fails to parse a style token next to
     * an @reference, i.e. `highlight: bold @background` is a parse error
     * while `highlight: @ref` and `highlight: bold #191d27` both work. */
    match-highlight: @primary;
    sel-match-highlight: bold #191d27;

    font: "Iosevka Nerd Font 13";
}

configuration {
    /* Ctrl+Tab cycles these. drun first: it is what $mod+d opens. */
    modes: [ "drun", "run", "window", "combi" ];

    /* What combi merges: running windows first, then .desktop apps, then
     * $PATH binaries. Typing a name switches to a running window or
     * launches it, whichever is right. Comma-separated, no # separator
     * needed here (this is a file, not an i3 exec line). */
    combi-modes: [ "window", "drun", "run" ];
    /* Without this every row in combi reads "Applications Firefox"; the
     * per-mode button row at the bottom already says which mode is active. */
    combi-hide-mode-prefix: true;

    display-drun:   "Applications";
    display-run:    "Run";
    display-window: "Windows";
    display-combi:  "All";
    display-keys:   "Shortcuts";

    drun-display-format: "{name}";
    window-format: "{w}  {t}";

    /* Matches `bindsym $mod+Return exec ghostty` in the i3 config, so
     * shift-enter (run in terminal) uses the same emulator. */
    terminal: "ghostty";

    /* Tokenized + case-insensitive search, ranked fzf-style. */
    tokenize: true;
    case-sensitive: false;
    matching: "normal";
    sorting-method: "fzf";
    scroll-method: 1;

    show-icons: true;
}

/* ---- Window ---- */

window {
    background-color: @background;
    border: 2px;
    border-color: @surface;
    border-radius: 8px;
    location: north;
    anchor: north;
    width: 46%;
    /* i3 gaps are inner 10 / outer 0, so stay clear of the 36px bar. */
    y-offset: 8px;
    font: @font;
}

/* ---- Layout ---- */

mainbox {
    background-color: transparent;
    spacing: 6px;
    children: [ "inputbar", "message", "listview", "mode-switcher" ];
}

/* ---- Input bar ---- */

inputbar {
    background-color: @surface;
    border-radius: 6px;
    border: 0px;
    padding: 8px 10px;
    spacing: 8px;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @primary;
    font: "Iosevka Nerd Font bold 13";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "type to search";
    placeholder-color: @muted;
    cursor-color: @primary;
    cursor-width: 2px;
    vertical-align: 0.5;
    font: @font;
}

/* Keep the case/sort indicator and row counters out of the way. */
case-indicator, num-rows, num-filtered-rows, textbox-current-entry, icon-current-entry {
    enabled: false;
}

/* ---- Message (rofi -e, and dmenu-style errors) ---- */

message {
    background-color: @surface;
    border-radius: 6px;
    border: 0px;
    padding: 10px 12px;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
}

/* ---- List ---- */

listview {
    background-color: transparent;
    /* The default theme draws a dashed 2px "dash" border around the list;
     * Theme 4 has no dividers. */
    border: 0px;
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    cycle: true;
    scrollbar: true;
    spacing: 2px;
}

element {
    background-color: transparent;
    border: 0px;
    border-radius: 6px;
    padding: 7px 10px;
    spacing: 10px;
    text-color: @foreground;
    font: @font;
}

/* Rofi paints rows through <state>.<state> selectors (element alternate.normal,
 * element selected.normal, ...) and those beat a bare `element selected`, so
 * they have to be overridden explicitly or the default theme's cream/grey
 * `lightbg` striping shows through. Both orderings are listed since rofi emits
 * the state pair in the order its own default theme uses. Theme 4 wants flat
 * rows with a single cream selection. */
element normal.normal,
element alternate.normal,
element normal.alternate {
    background-color: transparent;
    text-color: @foreground;
}

element selected,
element selected.normal,
element selected.alternate {
    background-color: @primary;
    border-color: @primary;
    text-color: @background;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent,
element normal.active,
element alternate.active,
element selected.active {
    background-color: @urgent;
    text-color: @background;
}

element-icon {
    size: 1.4em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-index {
    background-color: transparent;
    text-color: @muted;
    width: 1.2em;
    font: "Iosevka Nerd Font 11";
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    /* Matched characters take the primary accent instead of bold-black. */
    highlight: @match-highlight;
}

element selected element-text {
    text-color: @background;
    highlight: @sel-match-highlight;
}

element selected element-index {
    text-color: @background;
}

/* ---- Scrollbar ---- */

scrollbar {
    background-color: transparent;
    handle-color: @dot;
    handle-width: 6px;
    border-color: transparent;
    border-radius: 3px;
    padding: 2px 2px 2px 6px;
    handle-rounded-corners: true;
}

/* ---- Mode switcher (Ctrl+Tab) ---- */

mode-switcher {
    background-color: transparent;
    spacing: 6px;
    children: [ "drun", "run", "window", "combi" ];
}

button {
    background-color: @surface;
    text-color: @muted;
    border: 0px;
    border-radius: 6px;
    padding: 5px 12px;
    font: "Iosevka Nerd Font 11";
}

button selected {
    background-color: @primary;
    text-color: @background;
}

button selected hover,
button hover {
    background-color: @unfocused;
    text-color: @background;
}
